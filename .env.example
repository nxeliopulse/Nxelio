# ============================================================================
# Nxelio — environment template
#
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# This file is SAFE TO COMMIT — it must never contain a real secret.
# Every variable the code reads is listed here. "Required" means the feature
# next to it does not work at all without it.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase  —  REQUIRED, the app will not boot without these
# Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
# Public (browser-safe, inlined into the client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for migrations / psql only. Not read by the app.
# Percent-encode special characters in the password (@ becomes %40).
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# App URL  —  REQUIRED
# OAuth redirect target and webhook base. http://localhost:3000 in dev.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI providers  —  REQUIRED for the assistant, AI columns, and lead scoring
# Which provider is ACTIVE is chosen at runtime in Admin > AI Provider
# (ai_provider_settings table), not here. Keys for both can be present at once.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — secondary model tried when the primary model call fails.
AI_FALLBACK_MODEL=

# Legacy fallback for OpenAI. Only read when OPENAI_* above are unset.
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ---------------------------------------------------------------------------
# Email — Brevo  —  REQUIRED for signup mail, campaigns and newsletters
# Note: src/lib/email/resend.ts posts to Brevo's API despite the filename.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
# YOU choose this (any long random string). Use the same value in the Brevo
# webhook URL: https://YOUR_APP_URL/api/brevo/webhook?secret=<this>
BREVO_WEBHOOK_SECRET=

# Inbox for signup notifications and "send test email" in Settings.
EMAIL_TEST_RECIPIENT=
# Fallback reply-to, used only when no mailbox is connected in Settings > Connectors.
REPLY_TO_EMAIL=

# ---------------------------------------------------------------------------
# Billing — Stripe  —  REQUIRED for subscriptions, trials and credits
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the registered endpoint's secret in prod.
# Without it every POST /api/billing/webhook is rejected and nothing syncs.
STRIPE_WEBHOOK_SECRET=

# Optional in TEST mode — src/lib/stripe.ts falls back to built-in test price
# IDs. REQUIRED in LIVE mode: assertPriceIdsMatchMode() throws on the first
# Stripe call if a live key is paired with the test fallbacks.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ---------------------------------------------------------------------------
# Cron secrets
# YOU choose each one (any long random string). Supabase pg_cron sends it as
# "Authorization: Bearer <this>". Every route FAILS CLOSED with 401 when its
# secret is unset, so an unset value disables the schedule rather than opening it.
# ---------------------------------------------------------------------------
# /api/outreach/cron, /api/cron/reset-monthly-credits, and the fallback for
# /api/ai/proactive.
OUTREACH_CRON_SECRET=
# /api/leads/search-jobs/cron
LEAD_SEARCH_CRON_SECRET=
# /api/analytics/pipeline-snapshot/cron
PIPELINE_SNAPSHOT_CRON_SECRET=
# /api/analytics/report-schedules/cron
REPORT_SCHEDULE_CRON_SECRET=
# /api/ai/proactive — optional, falls back to OUTREACH_CRON_SECRET.
AI_PROACTIVE_CRON_SECRET=

# ---------------------------------------------------------------------------
# Outreach — Unipile (LinkedIn + Gmail/Outlook + reply webhooks)
# Optional. Leave blank to keep LinkedIn off and email on the Brevo fallback.
# ---------------------------------------------------------------------------
UNIPILE_DSN=
UNIPILE_API_KEY=
# YOU choose this. Use the same value in the Unipile webhook URL:
# /api/unipile/webhook?secret=<this>
UNIPILE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Lead data providers
# ---------------------------------------------------------------------------
# Bright Data — company/SERP discovery for Buy Leads.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# AnySite — LinkedIn profile and email lookup.
ANYSITE_API_KEY=
# Optional email-finder fallbacks — blank disables each.
HUNTER_API_KEY=
APOLLO_API_KEY=
FINDYMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Integrations — all optional
# ---------------------------------------------------------------------------
# HubSpot CRM sync (OAuth app credentials)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Calendar connectors — Settings > Connectors
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MS_CALENDAR_CLIENT_ID=
MS_CALENDAR_CLIENT_SECRET=
ZOHO_CALENDAR_CLIENT_ID=
ZOHO_CALENDAR_CLIENT_SECRET=

# Zoom — meeting links on booked demos
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Nylas — mailbox sync
NYLAS_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning — blank uses the default shown
# ---------------------------------------------------------------------------
# Idle session timeout, in minutes (default 30)
IDLE_TIMEOUT_MINUTES=
# How long before timeout the warning appears, in minutes (default 2)
IDLE_TIMEOUT_WARNING_MINUTES=
