# App URL — used for OAuth connect redirects and the cron webhook.
# Use http://localhost:3000 in dev; your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron auth — YOU choose this (any long random string). The pg_cron job sends it
# as "Authorization: Bearer <this>" so only Supabase can trigger the processor.
